# ---------- Banco ----------
DB_HOST=127.0.0.1
DB_USER=bot
DB_PASSWORD=
DB_DATABASE=pontos

# ---------- Twitch: chat ----------
CHANNEL_NAME=nome_do_canal
BOT_USERNAME=nome_do_bot
OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Twitch: API ----------
CLIENT_ID=
# CLIENT_SECRET habilita a renovação automática do token da API.
# Sem ele o bot cai no ACCESS_TOKEN fixo, que expira em algumas horas.
CLIENT_SECRET=
BROADCASTER_ID=

# Token fixo (legado). Só é usado se CLIENT_SECRET não estiver definido.
ACCESS_TOKEN=

# Refresh token de usuário com escopo channel:manage:vips.
# Necessário apenas para o bot aplicar o VIP na Twitch automaticamente.
TWITCH_REFRESH_TOKEN=

# ---------- Comportamento ----------
# Quem pode usar !pontos e !addpontos, além do dono do canal (separado por vírgula).
ADMIN_USERS=
# Teto por chamada do !addpontos.
ADDPONTOS_MAX=500
# Logs verbosos do tmi.js (todo o chat no stdout). Deixe false em produção.
DEBUG_TMI=false

TZ=America/Sao_Paulo

# Precisa ser igual a multiplicador_hora_extra em config/app.php do painel.
MULT_HORA_EXTRA=0.7
